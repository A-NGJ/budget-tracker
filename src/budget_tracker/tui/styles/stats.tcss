/* StatsScreen styles */
StatsScreen #title {
    text-align: center;
    text-style: bold;
    margin-bottom: 1;
    width: 100%;
}

StatsScreen #empty-state {
    margin: 2 4;
    text-align: center;
}

StatsScreen #filter-bar {
    margin: 0 2;
    height: auto;
}

StatsScreen #filter-row-1,
StatsScreen #filter-row-2 {
    height: 3;
}

StatsScreen #source-select,
StatsScreen #category-select,
StatsScreen #subcategory-select {
    width: 1fr;
}

StatsScreen #period-select {
    width: 1fr;
}

StatsScreen #keyword-input {
    width: 1fr;
}

StatsScreen #stats-tabs {
    margin: 1 2;
    height: auto;
}

StatsScreen #monthly-table {
    height: auto;
    max-height: 16;
}

StatsScreen #source-table {
    height: auto;
    max-height: 10;
}

StatsScreen #category-table {
    margin-top: 1;
    height: auto;
    max-height: 16;
}

StatsScreen #txn-list-header {
    text-style: bold;
    margin-top: 1;
}

StatsScreen #transaction-list {
    height: auto;
    max-height: 10;
}

StatsScreen #export-section {
    margin: 1 2;
    height: auto;
}

StatsScreen #format-label {
    text-style: bold;
    margin-bottom: 1;
}

StatsScreen #format-list {
    height: auto;
    max-height: 6;
}

StatsScreen #export-result {
    margin: 1 2;
    text-align: center;
}
